---
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import DataStamp from '../components/DataStamp.astro';
import MatchupRow from '../components/MatchupRow.astro';
import league from '../data/league.json';
import info from '../data/league-info.json';
import { LEAGUE } from '../lib/site.js';

const weeks = LEAGUE.weeks || league.weeks || [];
const poWeeks = weeks.filter((w) => w.isPlayoffs);
const teams = LEAGUE.playoffTeamCount || 4;
---
<Base
  title="Playoffs"
  kicker="The League"
  heading="Playoff Bracket"
  description="The Armchair Quarterbacks playoff picture — top 4 by total points."
>
  <section class="container section--tight po-wrap">
    <div class="po-rule panel panel--gold">
      <p class="kicker">How you get in</p>
      <p>
        Top <strong>{teams}</strong> teams make it, seeded 1–{teams} by
        <strong> total points scored</strong> in the regular season. {info.format.playoffWeeks} are
        the playoff weeks. 1 plays {teams}, 2 plays 3, winners meet for the ring.
      </p>
    </div>

    {poWeeks.length ? (
      <div class="bracket">
        {poWeeks.map((w) => (
          <section class="po-round">
            <div class="strip"><span aria-hidden="true">▚</span><span>Week {w.week}</span></div>
            <div class="po-round__games">
              {w.games.map((g) => <MatchupRow game={g} />)}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <EmptyState icon="bracket" title="Bracket sets after Week 13">
        The playoff field is decided the moment the regular season ends. Until then, keep an eye
        on the <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/standings'}>points race</a> —
        that's the tiebreaker, the seeding, the whole thing.
      </EmptyState>
    )}
    <DataStamp iso={league.generatedAt} />
  </section>
</Base>

<style>
  .po-wrap { max-width: 720px; }
  .po-rule { padding: 1.1rem 1.25rem; margin-bottom: 1.75rem; color: var(--chalk-dim); line-height: 1.7; }
  .po-rule p:last-child { margin-top: 0.4rem; }
  .po-rule strong { color: var(--penalty-flag); }
  .bracket { display: grid; gap: 1.5rem; }
  .po-round__games { display: grid; gap: 0.5rem; margin-top: 0.75rem; }
</style>
