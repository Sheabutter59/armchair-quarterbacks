---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Countdown from '../components/Countdown.astro';
import MemeOfWeek from '../components/MemeOfWeek.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TeamTag from '../components/TeamTag.astro';
import Icon from '../components/Icon.astro';
import { SECTIONS } from '../data/nav.js';
import info from '../data/league-info.json';
import history from '../data/history.json';
import news from '../data/news.json';
import league from '../data/league.json';
import { TEAMS, LEAGUE, teamById, recordStr, fmtDateTime, fmtDate, relTime, POT, withBase } from '../lib/site.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (h) => withBase(base, h);

const draft = LEAGUE.draft || {};
const draftUpcoming = draft.date && new Date(draft.date) > new Date() && !draft.completed;
const preseason = !LEAGUE.seasonStarted;

const reigning = history.seasons?.[0];
const champTeam = reigning ? teamById(reigning.champion.teamId) : null;
const sackoTeam = reigning ? teamById(reigning.lastPlace.teamId) : null;

// draft order -> team objects
const draftOrder = (draft.order || []).map((id) => teamById(id)).filter(Boolean);

// latest weekly award, if any
const weekly = league.awards?.weekly || [];
const latestAward = weekly[weekly.length - 1] || null;

const headlines = (news.items || []).slice(0, 5);

const quickLinks = SECTIONS.filter((s) => !['', 'teams'].includes(s.href));
---
<Base title={null} flush={true}>
  <!-- ============ HERO ============ -->
  <section class="snapsec hero">
    <div class="container hero__inner">
      <div class="hero__mark"><Wordmark /></div>

      {draftUpcoming && (
        <div class="hero__event panel">
          <Countdown iso={draft.date} label="The Draft is coming" doneLabel="THE DRAFT IS LIVE — get in there." />
          <p class="hero__eventmeta readout">
            {fmtDateTime(draft.date)} · {draft.type === 'SNAKE' ? 'Snake' : draft.type} draft
            {draft.secondsPerPick ? ` · ${draft.secondsPerPick}s per pick` : ''}
          </p>
        </div>
      )}

      {!draftUpcoming && preseason && (
        <div class="hero__event panel">
          <Countdown iso={info.seasonKickoff} label="Season kicks off" doneLabel="Week 1 is live. Check your lineup." />
          <p class="hero__eventmeta readout">Draft complete · Week 1 · {fmtDate(info.seasonKickoff)}</p>
        </div>
      )}

      {!preseason && (
        <div class="hero__event panel">
          <p class="kicker">Week {LEAGUE.currentWeek}</p>
          <p class="hero__live">Season's on. <a href={L('scoreboard')}>Open the scoreboard →</a></p>
        </div>
      )}

      <ul class="hero__facts">
        <li><span class="readout hero__factnum">{info.format.teams}</span><span>teams</span></li>
        <li><span class="readout hero__factnum">${POT}</span><span>pot</span></li>
        <li><span class="readout hero__factnum">{info.format.playoffTeams}</span><span>playoff spots</span></li>
        <li><span class="readout hero__factnum">PPR</span><span>scoring</span></li>
      </ul>

      {reigning && (
        <div class="belt panel panel--gold">
          <div class="belt__side belt__side--champ">
            <Icon name="trophy" size={24} class="belt__ico" />
            <div>
              <p class="kicker">{reigning.year} Champion</p>
              <p class="belt__team">{reigning.champion.team}</p>
              <p class="belt__owner readout">{reigning.champion.owner}</p>
            </div>
          </div>
          <div class="belt__side belt__side--sacko">
            <span class="belt__ico" aria-hidden="true">🚽</span>
            <div>
              <p class="kicker kicker--red">{reigning.year} Last Place</p>
              <p class="belt__team">{reigning.lastPlace.team}</p>
              <p class="belt__owner readout">{reigning.lastPlace.owner}</p>
            </div>
          </div>
          <a class="belt__link" href={L('champions')}>The whole ledger →</a>
        </div>
      )}
      <p class="scrollcue readout" aria-hidden="true">scroll ↓</p>
    </div>
  </section>

  <!-- ============ MEME OF THE WEEK ============ -->
  <section class="snapsec">
    <div class="container snapsec__inner">
      <SectionHeader label="Meme of the Week" href={L('memes')} hrefLabel="Meme wall" />
      <MemeOfWeek />
    </div>
  </section>

  <!-- ============ DRAFT ORDER ============ -->
  <section class="snapsec">
    <div class="container snapsec__inner">
      {draftOrder.length > 0 && !draft.completed ? (
        <>
          <SectionHeader label="Draft Order" sub={`Round 1 · ${draft.type === 'SNAKE' ? 'snakes back R2' : ''}`} />
          <ol class="draftorder panel">
            {draftOrder.map((t, i) => (
              <li class="draftorder__row">
                <span class="draftorder__pick readout">{String(i + 1).padStart(2, '0')}</span>
                <TeamTag team={t} size="sm" showOwner={true} />
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <SectionHeader label="This Week" href={L('scoreboard')} />
          <div class="panel emptybox"><p>No games on the board yet. The scoreboard wakes up in Week 1.</p></div>
        </>
      )}
    </div>
  </section>

  <!-- ============ WINNER / LOSER OF THE WEEK ============ -->
  <section class="snapsec">
    <div class="container snapsec__inner">
      <SectionHeader label="Winner / Loser of the Week" href={L('awards')} />
      {latestAward ? (
        <div class="awards2">
          <div class="panel award award--w">
            <p class="kicker">Week {latestAward.week} High</p>
            <TeamTag team={teamById(latestAward.high.teamId)} size="sm" />
            <p class="award__score readout">{latestAward.high.score}</p>
          </div>
          <div class="panel award award--l">
            <p class="kicker kicker--red">Week {latestAward.week} Low</p>
            <TeamTag team={teamById(latestAward.low.teamId)} size="sm" />
            <p class="award__score readout">{latestAward.low.score}</p>
          </div>
        </div>
      ) : (
        <div class="panel emptybox">
          <p>Every week, the high scorer gets a nod and the low scorer gets roasted here. First edition drops Week 1.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ============ AROUND THE NFL ============ -->
  <section class="snapsec">
    <div class="container snapsec__inner">
      <SectionHeader label="Around the NFL" href={L('news')} />
      {headlines.length ? (
        <ul class="headlines panel">
          {headlines.map((h) => (
            <li class="headlines__row">
              <a href={h.url} rel="noopener">{h.title}</a>
              <span class="headlines__meta readout">{h.source}{h.publishedAt ? ` · ${relTime(h.publishedAt)}` : ''}</span>
            </li>
          ))}
        </ul>
      ) : (
        <div class="panel emptybox">
          <p>NFL headlines land here automatically once the news feed is switched on.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ============ EVERYTHING ELSE ============ -->
  <section class="snapsec">
    <div class="container snapsec__inner">
      <SectionHeader label="Everything Else" />
      <div class="qlinks">
        {quickLinks.map((s) => (
          <a class="qlinks__item panel" href={L(s.href)}>
            <Icon name={s.icon} size={22} class="qlinks__ico" />
            <span>{s.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  document.documentElement.classList.add('js');
  const panels = document.querySelectorAll('.snapsec__inner');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    panels.forEach((p) => io.observe(p));
  } else {
    panels.forEach((p) => p.classList.add('in'));
  }
</script>

<style>
  /* full-height panels — one lands in view at a time as you scroll */
  :global(html) { scroll-snap-type: y proximity; scroll-padding-top: 64px; }

  .snapsec {
    scroll-snap-align: start;
    display: flex; flex-direction: column; justify-content: center;
    padding-block: clamp(2.25rem, 5vh, 3.5rem);
  }
  /* the hero fills the screen; the content sections are only as tall as they need
     to be plus a little breathing room, so the page reads fuller */
  .hero { min-height: 100vh; min-height: 100svh; padding-block: clamp(2rem, 5vh, 3.5rem); }
  .snapsec:not(.hero) { min-height: 62vh; }
  /* no dividers — the sections flow into one another over the continuous mesh */
  .snapsec__inner { width: 100%; max-width: 820px; margin-inline: auto; }
  /* each panel eases in as it scrolls up, so they hand off seamlessly */
  :global(html.js) .snapsec__inner {
    opacity: 0; transform: translateY(2.5rem);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(html.js) .snapsec__inner.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .snapsec__inner { opacity: 1; transform: none; transition: none; }
  }

  .hero {
    background:
      radial-gradient(135% 110% at 72% -25%, rgba(23,198,186,0.2), transparent 55%),
      radial-gradient(120% 90% at 8% 120%, rgba(106,52,214,0.14), transparent 55%);
  }
  .hero__inner { display: flex; flex-direction: column; align-items: center; gap: clamp(0.85rem, 2.2vw, 1.4rem); }
  .hero__mark { width: min(540px, 86%); }
  .hero__event { padding: clamp(0.9rem, 2vw, 1.35rem); width: min(600px, 100%); text-align: center; }
  .hero__eventmeta { margin-top: 0.6rem; font-size: 0.7rem; color: var(--chalk-dim); letter-spacing: 0.03em; }
  .hero :global(.cd__num) { font-size: clamp(1.35rem, 5.4vw, 2.35rem); padding: 0.28em 0.24em 0.2em; }
  .hero :global(.cd__clock) { gap: clamp(0.3rem, 1.2vw, 0.7rem); }
  .hero__live { font-size: 1.05rem; margin-top: 0.4rem; }
  .hero__facts {
    list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem; width: min(560px, 100%);
  }
  .hero__facts li {
    display: flex; flex-direction: column; align-items: center; gap: 0.15rem;
    background: var(--turf-line); border: 2px solid var(--hash-mark);
    padding: 0.6rem 0.5rem;
  }
  @media (max-width: 520px) { .hero__facts { grid-template-columns: 1fr 1fr; } }
  .hero__factnum { font-size: 1.35rem; font-weight: 600; color: var(--penalty-flag); }
  .hero__facts span:last-child {
    font-family: var(--font-mono); font-size: 0.6rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--chalk-dim);
  }

  .kicker--red { color: var(--blitz-red); }

  .scrollcue {
    margin-top: 0.5rem; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--chalk-faint); animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob { 50% { transform: translateY(4px); opacity: 0.6; } }

  .belt {
    display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.75rem;
    padding: 0.75rem; width: min(760px, 100%);
  }
  .belt__side { display: flex; align-items: center; gap: 0.85rem; padding: 0.7rem 0.9rem; flex: 1 1 240px; }
  .belt__side--champ { border-left: 5px solid var(--penalty-flag); background: rgba(23,198,186,0.1); }
  .belt__side--sacko {
    border-left: 5px solid var(--blitz-red);
    background: linear-gradient(150deg, #1c0303, #4a0000);
  }
  .belt__ico { color: var(--penalty-flag); font-size: 1.5rem; flex-shrink: 0; }
  .belt__team { font-weight: 700; font-size: 1.05rem; }
  .belt__owner { font-size: 0.72rem; color: var(--chalk-dim); text-transform: uppercase; letter-spacing: 0.06em; }
  .belt__side--sacko .belt__team { color: var(--on-ink); }
  .belt__side--sacko .belt__owner { color: #f0b8b8; }
  .belt__side--sacko .belt__ico { color: var(--blitz-red); }
  .belt__link {
    align-self: center; font-family: var(--font-mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--sky-pick);
    flex: 0 0 auto; padding: 0 0.5rem;
  }

  .home-grid { display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); }
  @media (min-width: 860px) { .home-grid { grid-template-columns: 1fr 1fr; align-items: start; } }

  .draftorder { list-style: none; }
  .draftorder__row {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.5rem 0.85rem; border-bottom: 1px solid var(--hash-mark);
  }
  .draftorder__row:last-child { border-bottom: 0; }
  .draftorder__pick { color: var(--penalty-flag); font-size: 0.95rem; width: 1.9rem; }

  .emptybox { padding: 1.5rem; color: var(--chalk-dim); font-size: 0.92rem; }

  .awards2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .award { padding: 1rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .award--w { border-left: 6px solid var(--first-down); }
  .award--l { border-left: 6px solid var(--blitz-red); }
  .award__score { font-size: 1.5rem; font-weight: 600; }

  .headlines { list-style: none; }
  .headlines__row { padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--hash-mark); }
  .headlines__row:last-child { border-bottom: 0; }
  .headlines__row a { color: var(--chalk); font-size: 0.9rem; font-weight: 500; }
  .headlines__row a:hover { color: var(--sky-pick); }
  .headlines__meta {
    display: block; margin-top: 0.2rem; font-size: 0.62rem; color: var(--chalk-faint);
    text-transform: uppercase; letter-spacing: 0.06em;
  }

  .qlinks { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.75rem; }
  .qlinks__item {
    display: flex; align-items: center; gap: 0.6rem; padding: 0.9rem 1rem;
    color: var(--chalk); font-family: var(--font-mono); font-size: 0.78rem;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .qlinks__item:hover { text-decoration: none; background: var(--turf-line-2); transform: translate(2px,2px); box-shadow: 2px 2px 0 0 var(--pixel-ink); }
  .qlinks__ico { color: var(--penalty-flag); flex-shrink: 0; }
</style>
