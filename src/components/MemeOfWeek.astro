---
import memes from '../data/memes.json';
import info from '../data/league-info.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * "Of the week" with no repeats: deterministically shuffle the whole meme list
 * (seed = year) and step through it one per ISO week. Every meme shows once
 * before any repeats; the order reshuffles each new year.
 */
function mulberry32(seed) {
  return function () {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function isoWeek(d = new Date()) {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const day = date.getUTCDay() || 7;
  date.setUTCDate(date.getUTCDate() + 4 - day);
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  return Math.ceil(((date - yearStart) / 86400000 + 1) / 7);
}

const list = [...(memes.memes || [])];
let pick = null;
if (list.length) {
  const year = new Date().getFullYear();
  const rand = mulberry32(year * 2654435761);
  for (let i = list.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [list[i], list[j]] = [list[j], list[i]];
  }
  pick = list[(isoWeek() - 1) % list.length];
}
const submitHref = info.repo && !info.repo.startsWith('your-username')
  ? `https://github.com/${info.repo}/issues/new?labels=meme&title=${encodeURIComponent('Meme submission')}&body=${encodeURIComponent('Paste your image below (drag it into this box) and add a caption:\n\nCaption: \n')}`
  : null;
---
{pick && (
  <figure class="mow panel">
    <img src={`${base}${pick.src}`} alt={pick.alt} loading="lazy" width="640" height="480" />
    <figcaption class="mow__cap">
      <span class="chip">Meme of the Week</span>
      <span class="mow__text">{pick.caption}</span>
      <span class="mow__links">
        {submitHref && <a class="mow__submit" href={submitHref} rel="noopener" target="_blank">+ submit yours</a>}
        <a class="mow__more" href={`${base}/memes`}>full wall →</a>
      </span>
    </figcaption>
  </figure>
)}
<style>
  .mow { overflow: hidden; }
  .mow img {
    width: 100%; height: auto; max-height: 460px; object-fit: contain;
    background: var(--turf-line-2); border-bottom: var(--border-nes);
  }
  .mow__cap {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem;
    padding: 0.85rem 1rem;
  }
  .mow__text { font-size: 0.9rem; color: var(--chalk); }
  .mow__links { margin-left: auto; display: flex; gap: 0.9rem; align-items: center; }
  .mow__submit, .mow__more {
    font-family: var(--font-sans); font-weight: 700; font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap;
  }
  .mow__submit { color: var(--first-down); }
  .mow__more { color: var(--sky-pick); }
</style>
