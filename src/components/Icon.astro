---
/** Tiny 16x16 pixel-grid icons drawn from rect runs. Deliberately chunky. */
interface Props { name: string; class?: string; size?: number; }
const { name, class: klass = '', size = 16 } = Astro.props;

// each icon = array of "row" strings, 16 cols, # = filled pixel
const ICONS: Record<string, string[]> = {
  home: ['       ##       ','      ####      ','     ##  ##     ','    ##    ##    ','   ##      ##   ','  ############  ','  ##        ##  ','  ##  ####  ##  ','  ##  ####  ##  ','  ##  ####  ##  ','  ############  '],
  score:['################','##            ##','##  ##    ##  ##','##  ##    ##  ##','##            ##','##  ########  ##','##            ##','##  ##    ##  ##','##  ##    ##  ##','##            ##','################'],
  vs:   ['##          ## ','##          ## ',' ##        ##  ',' ##   ##   ##  ','  ##  ##  ##   ','  ##  ##  ##   ','   ## ## ##    ','   ## ## ##    ','    ####  ##   ','    ####   ##  ','          ##  '],
  table:['################','##            ##','################','##    ##    ####','##    ##    ####','################','##    ##    ####','##    ##    ####','################','##    ##    ####','################'],
  bolt: ['        ####    ','       ####     ','      ####      ','     ####       ','    #########    ','   ##########    ','        ####     ','       ####      ','      ####       ','     ####        ','    ####         '],
  list: ['##  ##########  ','##  ##########  ','               ','##  ##########  ','##  ##########  ','               ','##  ##########  ','##  ##########  ','               ','##  ##########  ','##  ##########  '],
  roster:['     ####      ','    ######     ','    ######     ','     ####      ','   ########    ','  ##########   ',' ############  ',' ##  ####  ##  ','     ####      ','     ####      ','    ##  ##     '],
  swap:['     ##         ','    ####        ','   ##  #######  ','  ##            ','   ##  #######  ','    ####        ','     ##         ','        ##      ','  #######  ##   ','          ####  ','  #######  ##   '],
  bracket:['####            ','   #######      ','####      ##    ','          #####','####      ##    ','   #######      ','####            ','                ','   #############','                ','                '],
  star:['       ##       ','       ##       ','      ####      ','##############  ',' ############   ','   ########     ','  ##########    ','  ###    ###    ',' ###      ###   ','###        ###  '],
  trophy:[' ############  ',' ##        ##  ','###        ###','###        ###',' ##        ##  ','  ##########   ','     ####      ','     ####      ','   ########    ','  ##########   ','  ##########   '],
  news: ['############### ','#             # ','#  ##  #####   # ','#             # ','#  #########   # ','#             # ','#  #########   # ','#  ######      # ','#             # ','############### ','                '],
  people:['  ###    ###   ',' #####  #####  ',' #####  #####  ','  ###    ###   ',' ####    ####  ','#####    ##### ','#####    ##### ','####      #### ','              ','              ','              '],
  cash:['############### ','#  #########  # ','#  #       #  # ','#  #  ###  #  # ','#  #  ###  #  # ','#  #       #  # ','#  #########  # ','############### ','   #   #   #   ','              ','              '],
  book:['  ###########  ',' ##         ## ',' ##  #####   ##',' ##         ## ',' ##  #####   ##',' ##         ## ',' ##  ###     ##',' ##         ## ','  ###########  ','   #########   ','              '],
  meme:[' ############  ','##          ## ','## ##    ## ## ','## ##    ## ## ','##          ## ','## ##    ## ## ','##  ######  ## ','##          ## ',' ############  ','    ##  ##     ','   ##    ##    '],
};
const rows = ICONS[name] || ICONS.star;
const px = size / 16;
---
<svg class={klass} width={size} height={size} viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="image-rendering:pixelated;shape-rendering:crispEdges;display:block">
  {rows.flatMap((row, y) => [...row].map((c, x) => (c === '#' ? <rect x={x} y={y} width="1" height="1" fill="currentColor" /> : null)))}
</svg>
